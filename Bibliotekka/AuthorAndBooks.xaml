<Page x:Class="Bibliotekka.AuthorAndBooks"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Bibliotekka"
      mc:Ignorable="d" 
      d:DesignHeight="650" d:DesignWidth="900"
      Title="AuthorAndBooks"
      Background="#FF3D393D">

    <Grid>
        <Image Margin="0,0,0,565" Source="/Image2.png" Stretch="Fill"/>
        <TextBlock Text="МЕНЮ ДЕЙСТВИЙ" Foreground="White" 
                   FontWeight="Bold" FontSize="26" 
                   HorizontalAlignment="Center" Margin="0,15,0,585"/>

        <Grid Margin="30,65,30,30">
            <Grid.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FF8A7E89"/>
                    <GradientStop Color="#FFF3B4EE" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0" Grid.Column="0" CornerRadius="15" Margin="40,34,40,88" ClipToBounds="True">
                <Border.Background>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="#FF343434"/>
                        <GradientStop Color="#FF756A6A" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="75"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" 
                            CornerRadius="12" Background="#FFC69AC0" 
                            Width="60" Height="60" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Image Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" 
                           Height="50" Width="50" 
                           Source="/library_rwpe6um6gp11_256.png" 
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="0" Grid.Column="1" 
                               Text="ДОБАВИТЬ КНИГУ" 
                               Foreground="White" FontWeight="Bold" FontSize="14"
                               FontFamily="High Tower Text" TextWrapping="Wrap" Margin="8,0,0,0"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" 
                               Text="Внесите информацию о новой книге" 
                               Foreground="White" FontSize="12"
                               TextWrapping="Wrap" Margin="10,5,10,24" Grid.RowSpan="2"/>

                    <Button Grid.Row="2" Grid.Column="1" 
                            x:Name="addBook" Content="Добавить" 
                            Background="#FF9E7C95" Foreground="#FFFFF7F7" 
                            FontSize="13" FontWeight="Bold"
                            Width="100" Height="35" Margin="8,8,0,0" 
                            HorizontalAlignment="Left" Padding="5,0" Click="addBook_Click" VerticalAlignment="Top">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="20"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Border>

            <Border Grid.Row="0" Grid.Column="1" CornerRadius="15" Margin="10,34,65,88" ClipToBounds="True">
                <Border.Background>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="#FF393939"/>
                        <GradientStop Color="#FF756A6A" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="75"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" 
                            CornerRadius="12" Background="#FFC69AC0" 
                            Width="60" Height="60" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Image Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" 
                           Height="50" Width="50" 
                           Source="/chitatel_bc9twl0es7n4_256 (2).png" 
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="0" Grid.Column="1" 
                               Text="ЧИТАТЕЛИ" 
                               Foreground="White" FontWeight="Bold" FontSize="14"
                               TextWrapping="Wrap" Margin="8,0,0,0"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" 
                               Text="Просмотр списка, регистрация читателей" 
                               Foreground="White" FontSize="12"
                               TextWrapping="Wrap" Margin="10,8,-2,21" Grid.RowSpan="2"/>

                    <Button Grid.Row="2" Grid.Column="1" 
                            x:Name="readersButton" Content="Перейти" 
                            Background="#FF9E7C95" Foreground="#FFFFF7F7" 
                            FontSize="13" FontWeight="Bold"
                            Width="100" Height="35" Margin="8,8,0,0" 
                            HorizontalAlignment="Left" Padding="5,0" Click="readersButton_Click">
                        <Button.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="20"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Border>
            
            <Border Grid.Row="1" Grid.Column="0" CornerRadius="15" Margin="48,8,40,115" ClipToBounds="True">
                <Border.Background>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="#FF413E3E"/>
                        <GradientStop Color="#FF756A6A" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="75"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" 
                            CornerRadius="12" Background="#FFC69AC0" 
                            Width="60" Height="60" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Image Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" 
                           Height="50" Width="50" 
                           Source="/kniga_1d83ygjt385m_256 (1).png" 
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="0" Grid.Column="1" 
                               Text="ВЫДАЧА КНИГ" 
                               Foreground="White" FontWeight="Bold" FontSize="14"
                               TextWrapping="Wrap" Margin="8,0,0,0"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" 
                               Foreground="White" FontSize="12"
                               TextWrapping="Wrap" Margin="8,2,10,38" Grid.RowSpan="2" Text="Оформите выдачу книги"/>
                    <Button Grid.Row="2" Grid.Column="1" 
                            x:Name="loansButton" Content="Выдача" 
                            Background="#FF9E7C95" Foreground="#FFFFF7F7" 
                            FontSize="13" FontWeight="Bold"
                            Width="100" Height="35" Margin="8,8,0,0" 
                            HorizontalAlignment="Left" Padding="5,0" VerticalAlignment="Top" Click="loansButton_Click">
                        <Button.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="20"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Border>

            <Border Grid.Row="1" Grid.Column="1" CornerRadius="15" Margin="8,8,50,115" ClipToBounds="True">
                <Border.Background>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="#FF353131"/>
                        <GradientStop Color="#FF756A6A" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="75"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" 
                            CornerRadius="12" Background="#FFC69AC0" 
                            Width="60" Height="60" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Image Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" 
                           Height="50" Width="50" 
                           Source="/home_iwza1h9c58wk_256.png" 
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="0" Grid.Column="1" 
                               Text="НА ГЛАВНУЮ СТРАНИЦУ" 
                               Foreground="White" FontWeight="Bold" FontSize="14"
                               TextWrapping="Wrap" Margin="8,0,0,0"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" 
                               Text="Вернуться на главную страницу" 
                               Foreground="White" FontSize="12"
                               TextWrapping="Wrap" Margin="8,2,0,38" Grid.RowSpan="2"/>


                    <Button Grid.Row="2" Grid.Column="1" 
                            x:Name="back_homeButton" Content="Вернуться" 
                            Background="#FF9E7C95" Foreground="#FFFFF7F7" 
                            FontSize="13" FontWeight="Bold"
                            Width="100" Height="35" Margin="8,8,0,0" 
                            HorizontalAlignment="Left" Padding="5,0"
                            Click="back_homeButton_Click">
                        <Button.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="20"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <Frame x:Name="MainFrame" Visibility="Collapsed" Panel.ZIndex="10"/>
    </Grid>
</Page>